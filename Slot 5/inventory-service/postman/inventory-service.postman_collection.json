{
  "info": {
    "name": "Inventory Service",
    "description": "10 test cases for Part 1. Case 9 intentionally records current behavior without positive-quantity validation. Requests do not change inventory.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Check Stock - In Stock",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{inventory_base_url}}/api/inventory?skuCode=iphone_15&quantity=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Body is true\", () => pm.expect(pm.response.text()).to.eql(\"true\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Check Stock - Insufficient Stock",
