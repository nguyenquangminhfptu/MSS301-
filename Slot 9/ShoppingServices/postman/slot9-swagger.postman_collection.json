{
  "info": {
    "name": "MSS301 Slot 9 - Swagger integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Part 5 docs, JWT security and Part 1-4 regression on the local Slot 9 stack. Creates one order and removes its own demo product."
  },
  "item": [
    {
      "name": "01 - Keycloak demo token",
      "request": {
        "method": "POST",
        "url": "{{keycloak}}/realms/spring-microservices-realm/protocol/openid-connect/token",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "shopping-swagger",
              "type": "text"
            },
            {
              "key": "username",
              "value": "student",
              "type": "text"
            },
            {
              "key": "password",
              "value": "demo-local-123",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const token = pm.response.json().access_token;",
              "pm.test(\"JWT received\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
              "pm.environment.set(\"access_token\", token);"
            ]
          }
        }
      ]
    },
