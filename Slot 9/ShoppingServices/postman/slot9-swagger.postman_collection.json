        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Created product is listed\", () => pm.expect(pm.response.json().some(p => p.id === pm.environment.get(\"product_id\"))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Gateway JWT - update product",
      "request": {
        "method": "PUT",
        "url": "{{gateway}}/api/products/{{product_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
