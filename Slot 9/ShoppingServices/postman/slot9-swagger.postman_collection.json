      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const spec = pm.response.json();",
              "pm.test(\"Required metadata\", () => { pm.expect(spec.info.title).to.eql(\"Product Service API\"); pm.expect(spec.info.version).to.eql(\"v0.0.1\"); });",
              "pm.test(\"Real API path\", () => pm.expect(spec.paths).to.have.property(\"/api/products\"));",
              "pm.test(\"Gateway compatible JWT UI\", () => { pm.expect(spec.servers[0].url).to.eql(\"/\"); pm.expect(spec.components.securitySchemes.bearerAuth.scheme).to.eql(\"bearer\"); });"
            ]
          }
        }
      ]
    },
