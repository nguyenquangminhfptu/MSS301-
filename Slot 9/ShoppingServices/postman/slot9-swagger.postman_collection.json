    {
      "name": "Gateway - CRUD CORS preflight",
      "request": {
        "method": "OPTIONS",
        "url": "{{gateway}}/api/products",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:8080"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "PUT"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "authorization,content-type"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"CORS permits PUT\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"PUT\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Gateway JWT - create product",
      "request": {
        "method": "POST",
        "url": "{{gateway}}/api/products",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Slot 9 Swagger Demo\", \"description\": \"Integration verification\", \"price\": 99.5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const product = pm.response.json();",
              "pm.test(\"Product created\", () => pm.expect(product.id).to.be.a(\"string\").and.not.empty);",
              "pm.environment.set(\"product_id\", product.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Gateway JWT - list products",
      "request": {
        "method": "GET",
        "url": "{{gateway}}/api/products",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
