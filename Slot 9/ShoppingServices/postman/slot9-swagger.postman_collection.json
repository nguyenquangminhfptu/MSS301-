              "pm.test(\"Swagger HTML\", () => pm.expect(pm.response.text()).to.include(\"Swagger UI\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Product - direct OpenAPI JSON",
      "request": {
        "method": "GET",
        "url": "{{product}}/api-docs",
        "header": []
