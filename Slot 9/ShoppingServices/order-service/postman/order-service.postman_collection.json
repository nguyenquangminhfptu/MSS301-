    {
      "name": "05 Create Order - Missing Content-Type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "disabled": true
          }
        ],
        "url": "{{order_base_url}}/api/order",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 1000,\n  \"quantity\": 1\n}"
        },
        "description": "Content-Type is disabled explicitly and via disabledSystemHeaders to prevent Postman/Newman from inserting text/plain. Expected 415."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 415\", () => pm.response.to.have.status(415));",
              "pm.test(\"No active Content-Type header\", () => pm.expect(pm.request.headers.all().filter(h => !h.disabled && h.key.toLowerCase() === \"content-type\")).to.have.lengthOf(0));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {
          "content-type": true
        }
      }
    },
