{
  "info": {
    "name": "Order Service",
    "description": "8 test cases matching the Part 1 tutorial. Select order-service-local environment. A run inserts four orders; existing rows are preserved.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Create Order - Success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "disabled": false
          }
        ],
        "url": "{{order_base_url}}/api/order",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 1000,\n  \"quantity\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Response body is correct message\", () => pm.expect(pm.response.text()).to.eql(\"Order Placed Successfully\"));",
              "pm.test(\"Content-Type is text/plain\", () => pm.expect(pm.response.headers.get(\"Content-Type\").split(\";\")[0]).to.eql(\"text/plain\"));"
            ]
          }
        }
      ]
    },
