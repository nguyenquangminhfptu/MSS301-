        {
          "name": "Place order kb8",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{orderUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\"customerId\": \"C1\", \"productId\": \"P2\", \"quantity\": 1, \"amount\": 20}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const o=pm.response.json();",
                  "pm.collectionVariables.set(\"kb8OrderId\",o.id);",
                  "pm.test(\"order PENDING\",()=>pm.expect(o.status).to.eql(\"PENDING\"));",
                  "pm.test(\"saga COMPENSATING\",()=>pm.expect(o.sagaStatus).to.eql(\"COMPENSATING\"));",
                  "pm.test(\"failure reason\",()=>pm.expect(o.failureReason).to.match(new RegExp(\"^Service kh\\u00f4ng ph\\u1ea3n h\\u1ed3i\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Saga logs kb8",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderUrl}}/api/orders/{{kb8OrderId}}/saga-logs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const logs=pm.response.json();",
                  "pm.test(\"ordered persisted logs\",()=>{ pm.expect(logs.length).to.be.above(0); logs.forEach((l,i)=>{pm.expect(l.orderId).to.eql(Number(pm.collectionVariables.get(\"kb8OrderId\"))); pm.expect(l.time).to.be.a(\"string\"); if(i) pm.expect(l.id).to.be.above(logs[i-1].id); }); });",
                  "pm.test(\"exactly three failed compensations\",()=>pm.expect(logs.filter(l=>l.step===\"COMPENSATION\"&&l.result===\"FAILED\")).to.have.length(3));",
                  "pm.test(\"no cancellation\",()=>pm.expect(logs.map(l=>l.step)).not.to.include(\"CANCEL_ORDER\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
